{
  "name": "faji-worker-service",
  "version": "1.0.0",
  "private": true,
  "description": "Durable notification scheduling and delivery service for Faji",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-poster-assets.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "amqplib": "^0.10.5",
    "axios": "^1.7.9",
    "croner": "^9.0.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "luxon": "^3.5.0",
    "opentype.js": "^1.3.4",
    "pino": "^9.6.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/opentype.js": "^1.3.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
