{
  "name": "faji-worker-service",
  "version": "1.0.0",
  "private": true,
  "description": "Durable notification scheduling and delivery service for Faji",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
