NODE_ENV=development
SERVICE_NAME=faji-worker-service
PORT=8090
LOG_LEVEL=info

# Central time configuration. All cron expressions use this IANA zone.
APP_TIMEZONE=Africa/Lagos

BACKEND_BASE_URL=http://host.docker.internal:4583/v1
BACKEND_WORKER_API_KEY=replace-me
RECIPIENT_PAGE_SIZE=250
HTTP_TIMEOUT_MS=15000

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=faji-worker
DELIVERY_RECORD_TTL_DAYS=90
PROCESSING_LOCK_SECONDS=300

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=faji.notifications
RABBITMQ_QUEUE=faji.notifications.deliver
RABBITMQ_DLQ=faji.notifications.dead
RABBITMQ_PREFETCH=20
MAX_DELIVERY_ATTEMPTS=5
RETRY_DELAYS_MS=5000,30000,120000,600000

# Jobs are JSON so schedules remain centralized and deploy-time configurable.
JOBS_JSON=[{"key":"event-reminder","cron":"0 9 * * *","channels":["email","sms"],"recipientPath":"/internal/worker/jobs/event-reminder/recipients"},{"key":"weekly-digest","cron":"0 9 * * 1","channels":["email"],"recipientPath":"/internal/worker/jobs/weekly-digest/recipients"}]

# ZeptoMail-compatible HTTP API
MAIL_API_URL=https://api.zeptomail.com/v1.1/email
MAIL_API_TOKEN=
MAIL_FROM_ADDRESS=noreply@faajii.com
MAIL_FROM_NAME=Faajii

# OpenSi-compatible SMS API
SMS_API_URL=https://notice-api.opensi.co/api/v0.2.3/sms
SMS_API_KEY=
SMS_SENDER_ID=Faajii
SMS_ALLOWED_COUNTRY_CODES=234,229,225,221,228,227
DRY_RUN=true
